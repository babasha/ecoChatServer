# ================================================================
# КОНФИГУРАЦИЯ БД ДЛЯ ЛОГОВ (LOGS DATABASE)
# ================================================================
# Эти переменные нужно добавить в Railway для подключения к БД логов

# ================================================================
# ВАРИАНТ 1 (РЕКОМЕНДУЕТСЯ): Используем Railway Variable Reference
# ================================================================
# Это использует приватную сеть Railway (*.railway.internal)
# В Railway Variables добавьте:
#
#    LOGS_DB_URL = ${{ Logs.DATABASE_URL }}
#
# Готово! Одна переменная вместо шести.

# ================================================================
# ВАРИАНТ 2: Отдельные переменные (если нужен публичный доступ)
# ================================================================
# БД для server_logs и websocket_logs (shuttle.proxy.rlwy.net)
LOGS_DB_HOST=shuttle.proxy.rlwy.net
LOGS_DB_PORT=23652
LOGS_DB_USER=postgres
LOGS_DB_PASSWORD=fuCZBSFlmElyUVDRWtNrdYgAdROLbaWs
LOGS_DB_NAME=railway
LOGS_DB_SSL_MODE=require

# ================================================================
# КАК НАСТРОИТЬ В RAILWAY:
# ================================================================
# 1. Откройте ваш проект в Railway
# 2. Перейдите в сервис ecoChatServer → Variables
# 3. Нажмите "New Variable"
# 4. Добавьте переменную:
#
#    Variable name: LOGS_DB_URL
#    Value: ${{ Logs.DATABASE_URL }}
#
# 5. Сохраните - Railway автоматически передеплоит приложение
#
# ================================================================
# РЕЗУЛЬТАТ:
# ================================================================
# После деплоя логи будут записываться в отдельную БД через приватную сеть:
# - server_logs → llmdb.railway.internal (системные логи)
# - websocket_logs → llmdb.railway.internal (WebSocket логи)
#
# Основные данные останутся в БД чатов:
# - chats, messages, users → chatdb.railway.internal
