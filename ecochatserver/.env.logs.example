# ================================================================
# КОНФИГУРАЦИЯ БД ДЛЯ ЛОГОВ (LOGS DATABASE)
# ================================================================
# Эти переменные нужно добавить в Railway для подключения к БД логов

# БД для server_logs и websocket_logs (shuttle.proxy.rlwy.net)
LOGS_DB_HOST=shuttle.proxy.rlwy.net
LOGS_DB_PORT=23652
LOGS_DB_USER=postgres
LOGS_DB_PASSWORD=fuCZBSFlmElyUVDRWtNrdYgAdROLbaWs
LOGS_DB_NAME=railway
LOGS_DB_SSL_MODE=require

# ================================================================
# КАК НАСТРОИТЬ В RAILWAY:
# ================================================================
# 1. Откройте ваш проект в Railway
# 2. Перейдите в Variables
# 3. Добавьте следующие переменные:
#
#    LOGS_DB_HOST = shuttle.proxy.rlwy.net
#    LOGS_DB_PORT = 23652
#    LOGS_DB_USER = postgres
#    LOGS_DB_PASSWORD = fuCZBSFlmElyUVDRWtNrdYgAdROLbaWs
#    LOGS_DB_NAME = railway
#    LOGS_DB_SSL_MODE = require
#
# 4. Сохраните и передеплойте приложение
#
# ================================================================
# РЕЗУЛЬТАТ:
# ================================================================
# После деплоя логи будут записываться в отдельную БД:
# - server_logs → shuttle.proxy.rlwy.net  (системные логи)
# - websocket_logs → shuttle.proxy.rlwy.net (WebSocket логи)
#
# Основные данные останутся в БД чатов:
# - chats, messages, users → maglev.proxy.rlwy.net
